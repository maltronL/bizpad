# Payment link for Pro (Lemon Squeezy, Paddle, Gumroad, Stripe Payment Link...)
NEXT_PUBLIC_CHECKOUT_URL=https://your-store.lemonsqueezy.com/buy/your-product
# Price shown on the site (text only)
NEXT_PUBLIC_PRO_PRICE=$5
# Your live site URL (needed for sitemap and SEO)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Keys you hand out manually (comma-separated), optional
LICENSE_KEYS=
# 1 = validate customer keys with Lemon Squeezy automatically
LEMONSQUEEZY_VALIDATE=1
